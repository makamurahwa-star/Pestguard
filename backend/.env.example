# PestGuard backend environment file.
# Copy this to ".env" (no .example) and edit the values.
# python-dotenv loads it automatically when app.py starts.

# ─── Database ─────────────────────────────────────────────────────
# Default XAMPP MySQL has user=root with EMPTY password.
# If you've set a password in phpMyAdmin's User Accounts, put it after "root:".
DATABASE_URL=mysql+pymysql://root:@localhost:3306/pestguard?charset=utf8mb4

# ─── Secrets (change these in production!) ────────────────────────
SECRET_KEY=local-dev-secret-key-change-me
JWT_SECRET_KEY=local-dev-jwt-secret-change-me

# ─── Optional: where uploads + sqlite (if any) live ───────────────
# DATA_DIR=C:/dev/pestguard/backend
# UPLOAD_FOLDER=C:/dev/pestguard/backend/uploads

# ─── ML model location (default is backend/ml_model/pestguard_model.pt) ────
# MODEL_PATH=C:/dev/pestguard/backend/ml_model/pestguard_model.pt
